{
  "name": "researchbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Independent synthetic-data prototype for explainable EUReCA research placement",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors red,gray \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:api": ".venv/bin/python -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:backend": ".venv/bin/python -m pytest backend/tests",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:migrate": ".venv/bin/python -m backend.app.db migrate",
    "db:seed": ".venv/bin/python -m backend.app.seed.seed_data",
    "db:reset": ".venv/bin/python -m backend.app.seed.seed_data --reset --confirm RESET_SYNTHETIC_DEMO",
    "evidence:benchmark": ".venv/bin/python -m backend.app.evidence"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "clsx": "2.1.1",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
