# Public URL of the local ResearchBridge API. This contains no secret.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Local synthetic-demo database. Do not point this prototype at student records.
RESEARCHBRIDGE_DATABASE_URL=sqlite:///./backend/data/researchbridge.db

# Comma-separated browser origins allowed by the local API.
RESEARCHBRIDGE_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional solver limit per optimization stage in seconds.
RESEARCHBRIDGE_SOLVER_TIMEOUT_SECONDS=10
